library(shiny)
library(DBI)
library(RSQLite)
# Connect to the database
con <- dbConnect(
SQLite(),
"database/covid.sqlite"
)
# Retrieve COVID-19 data
data <- dbReadTable(con, "covid_reports")
dbDisconnect(con)
# User interface
ui <- fluidPage(
titlePanel("Canadian COVID-19 Analytics Dashboard"),
sidebarLayout(
sidebarPanel(
selectInput(
"province",
"Select Province:",
choices = sort(unique(data$prname)),
selected = "Alberta"
)
),
mainPanel(
h3("COVID-19 Data"),
tableOutput("covid_table"),
h3("Total Cases by Reporting Week"),
plotOutput("cases_plot")
)
)
)
# Server logic
server <- function(input, output, session) {
filtered_data <- reactive({
subset(data, prname == input$province)
})
output$covid_table <- renderTable({
head(filtered_data(), 10)
})
output$cases_plot <- renderPlot({
df <- filtered_data()
df <- df[order(df$reporting_year,
df$reporting_week), ]
plot(
seq_len(nrow(df)),
df$totalcases,
type = "l",
col = "blue",
lwd = 2,
main = paste("COVID-19 Cases in", input$province),
xlab = "Reporting Period",
ylab = "Total Cases"
)
})
}
# Start Shiny application
shinyApp(ui = ui, server = server)
library(shiny)
library(DBI)
library(RSQLite)
# Connect to the database
con <- dbConnect(
SQLite(),
"database/covid.sqlite"
)
# Retrieve COVID-19 data
data <- dbReadTable(con, "covid_reports")
dbDisconnect(con)
# User interface
ui <- fluidPage(
titlePanel("Canadian COVID-19 Analytics Dashboard"),
sidebarLayout(
sidebarPanel(
selectInput(
"province",
"Select Province:",
choices = sort(unique(data$prname)),
selected = "Alberta"
)
),
mainPanel(
h3("COVID-19 Data"),
DT::DTOutput("covid_table"),
h3("Total Cases by Reporting Week"),
plotOutput("cases_plot")
)
)
)
# Server logic
server <- function(input, output, session) {
filtered_data <- reactive({
subset(data, prname == input$province)
})
output$covid_table <- DT::renderDT({
DT::datatable(
filtered_data(),
options = list(
pageLength = 10,
scrollX = TRUE
),
filter = "top",
rownames = FALSE
)
})
output$cases_plot <- renderPlot({
df <- filtered_data()
df <- df[order(df$reporting_year,
df$reporting_week), ]
plot(
seq_len(nrow(df)),
df$totalcases,
type = "l",
col = "blue",
lwd = 2,
main = paste("COVID-19 Cases in", input$province),
xlab = "Reporting Period",
ylab = "Total Cases"
)
})
}
# Start Shiny application
shinyApp(ui = ui, server = server)
